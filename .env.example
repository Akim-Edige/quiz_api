database_url="postgresql+asyncpg://postgres:password@localhost:5432/finelo_quiz"
database_read_replica_url=""

# Redis
redis_url="redis://localhost:6379/0"

# AWS S3
aws_access_key_id=None
aws_secret_access_key=None
aws_region="us-east-1"
s3_bucket="finelo-quiz-assets"

# CDN
cdn_domain="http://localhost:4566/finelo-quiz-assets/"

# Cache settings
quiz_cache_ttl=3600  # 1 hour
stats_cache_ttl=300   # 5 minutes

# API settings
api_title="Finelo Quiz API"
api_version="1.0.0"
debug=false

# Matching
matching_side_id_salt="finelo-quiz-matching-salt"